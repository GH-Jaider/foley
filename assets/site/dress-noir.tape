# The moviola take for the window dress: the look is one cue; the
# script never changes. The website screens it in noir.
Output dress-noir.gif
Require bash
Set Shell bash
Set Width 640
Set Height 360
Set FontSize 15
Set TypingSpeed 45ms
Set WaitTimeout 20s
# foley: dress noir
# foley: studio
Sleep 400ms
Type "echo one take, many dresses"
Enter
Wait
Sleep 1400ms
